<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MaintainPro - Property Management</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    
    <style>
        /* Reset and Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: #f8f9fa;
            color: #333;
        }

        /* Hero Section */
        .hero-section {
            position: relative;
            width: 100%;
            height: 100vh;
            min-height: 600px;
            background: url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop') no-repeat center center/cover;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Overlay semi-transparent white card background look */
        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.4);
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px 40px;
        }

        /* Header / Navigation */
        header {
            width: 100%;
            max-width: 1200px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 700;
            font-size: 1.2rem;
            color: #1a2b4c;
        }

        .logo-icon {
            width: 24px;
            height: 24px;
            background-color: #2563eb;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 12px;
        }

        /* Glassmorphism Hero Card Container */
        .hero-card {
            margin: auto 0;
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 60px 40px;
            text-align: center;
            max-width: 800px;
            width: 90%;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        }

        .hero-title {
            font-size: 2.8rem;
            font-weight: 700;
            color: #111827;
            line-height: 1.2;
            margin-bottom: 20px;
        }

        .hero-subtitle {
            font-size: 1rem;
            color: #6b7280;
            margin-bottom: 30px;
        }

        .btn-primary {
            background-color: #2563eb;
            color: white;
            border: none;
            padding: 12px 32px;
            font-size: 0.95rem;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }

        .btn-primary:hover {
            background-color: #1d4ed8;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.4);
        }

        /* About Section */
        .about-section {
            background-color: #ffffff;
            padding: 80px 20px;
            text-align: center;
        }

        .about-container {
            max-width: 700px;
            margin: 0 auto;
        }

        .about-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #111827;
            margin-bottom: 20px;
        }

        .about-description {
            font-size: 0.95rem;
            color: #6b7280;
            line-height: 1.6;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .hero-title {
                font-size: 2rem;
            }
            .hero-card {
                padding: 40px 20px;
            }
        }
    </style>
</head>
<body>

    <!-- Hero Section -->
    <section class="hero-section" id="hero-section">
        <div class="hero-overlay">
            
            <!-- Navbar / Header -->
            <header>
                <div class="logo">
                    <div class="logo-icon">✓</div>
                    <span>MaintainPro</span>
                </div>
            </header>

            <!-- Main Hero Card Content -->
            <div class="hero-card">
                <h1 class="hero-title">Manage Your Property Easily<br>& Efficiently</h1>
                <p class="hero-subtitle">Manage properties, tenants and maintenance requests in one place.</p>
                <button class="btn-primary" id="getStartedBtn">Get Started</button>
            </div>

        </div>
    </section>

    <!-- About Section -->
    <section class="about-section" id="about-section">
        <div class="about-container">
            <h2 class="about-title">About MaintainPro</h2>
            <p class="about-description">
                MaintainPro is a platform that simplifies property maintenance management by connecting residents and property managers, enabling easy submission and tracking of maintenance requests in real-time.
            </p>
        </div>
    </section>

    <!-- JavaScript -->
    <script>
        document.getElementById('getStartedBtn').addEventListener('click', function() {
            // Scroll smoothly to About section or perform an action
            document.getElementById('about-section').scrollIntoView({ 
                behavior: 'smooth' 
            });
            
            // Example action: alert or modal
            // alert('Welcome to MaintainPro!');
        });
    </script>
</body>
</html> 